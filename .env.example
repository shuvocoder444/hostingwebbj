DEBUG=True
SECRET_KEY=replace-with-a-unique-random-django-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_DOMAIN=localhost

# Keep SQLite for local development. On the server, use PostgreSQL and the
# database name/user exactly as shown by the hosting provider.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Generate a unique Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-unique-fernet-key

# Configure the real payment gateway credentials only in the server environment.
GATEWAY_API_KEY=
GATEWAY_API_SECRET=
